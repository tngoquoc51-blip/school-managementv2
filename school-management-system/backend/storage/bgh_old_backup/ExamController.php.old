<?php

namespace Modules\Academic\Controllers;

use Illuminate\Http\Request;
use Modules\Academic\Services\ExamScheduleService;

class ExamController extends BghController
{
    public function __construct(private ExamScheduleService $svc) {}

    public function periods(Request $r)
    {
        return $this->success($this->svc->periods($this->year($r)));
    }

    public function schedule(int $period)
    {
        return $this->run(fn () => $this->svc->schedule($period));
    }

    public function save(Request $r, int $period)
    {
        $d = $r->validate([
            'grade' => 'required|integer|in:10,11,12',
            'subject_id' => 'required|integer',
            'exam_date' => 'required|date_format:Y-m-d',
            'start_time' => 'required|date_format:H:i:s',
            'duration_minutes' => 'required|integer|between:15,240',
            'exam_format' => 'required|string|max:30',
        ]);

        return $this->run(fn () => $this->svc->save($period, $d, $this->actor($r)), 'Đã lưu lịch thi');
    }

    public function destroy(Request $r, int $id)
    {
        return $this->run(fn () => $this->svc->schedule($this->svc->delete($id, $this->actor($r))), 'Đã xóa lịch thi');
    }
}
